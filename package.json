{
  "name": "cinema-catalog-manager",
  "version": "0.1.0-stage1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:deploy",
    "test:unit": "node --test tests/service.test.js tests/worker.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:deploy": "python -m unittest discover -s tests -p test_*.py",
    "check:bundle": "wrangler deploy --dry-run --outdir .build",
    "dev": "wrangler dev --local",
    "deploy:worker": "wrangler deploy --config wrangler.local.jsonc"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "wrangler": "4.160.0"
  }
}
